{
  "kind": "vector_store",
  "version": "0.1.0",
  "title": "Vector Store",
  "description": "Embed texts and search them by meaning in a local vector collection.",
  "repository_url": "https://github.com/HackInvent/bloxmith-vector-store",
  "bloxsmith_compatibility": [
    "1.0.9"
  ],
  "tested_with_bloxsmith": "1.0.9",
  "prerequisites": [
    {
      "type": "manual",
      "name": "An OpenAI-compatible /v1/embeddings endpoint (for example a local Ollama, LM Studio or vLLM server, or a hosted API) and an embedding model available on it."
    },
    {
      "type": "manual",
      "name": "Python standard-library sqlite3; no SQLite extension is loaded."
    },
    {
      "type": "manual",
      "name": "Optional: numpy in the Studio Python environment for fast search of large collections; without it a pure-Python scan serves up to 8,000,000 vector values per query."
    }
  ],
  "locales": {
    "en": "locales/en.json",
    "fr": "locales/fr.json"
  },
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "documents",
        "title": "documents",
        "accepts": [
          "application/json",
          "text/plain",
          "message/*"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution"
      },
      {
        "id": 2,
        "name": "query",
        "title": "query",
        "accepts": [
          "application/json",
          "text/plain",
          "message/*"
        ],
        "multiplicity": "one",
        "required": false,
        "execution_requirement": "not_required_for_execution"
      }
    ],
    "outputs": [
      {
        "id": 1,
        "name": "matches",
        "title": "matches",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      },
      {
        "id": 2,
        "name": "result",
        "title": "result",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      },
      {
        "id": 3,
        "name": "error",
        "title": "error",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      }
    ]
  },
  "config": {
    "collection": "default",
    "base_url": "http://127.0.0.1:11434/v1",
    "model": "nomic-embed-text",
    "api_key_ref": "",
    "top_k": 5,
    "min_score": 0.0,
    "chunk_size": 1000,
    "chunk_overlap": 100,
    "allow_delete": false,
    "query_prefix": "",
    "document_prefix": "",
    "allow_remote": false,
    "allow_insecure_http": false,
    "ca_file": "",
    "batch_size": 32,
    "timeout_sec": 60,
    "max_items": 20000,
    "max_text_chars": 8000,
    "max_input_bytes": 4194304,
    "max_response_bytes": 16777216,
    "max_database_mb": 512
  },
  "port_capabilities": {
    "can_add_inputs": false,
    "can_add_outputs": false
  },
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "active_worker": true,
    "centralized_executor": "generic",
    "centralized_dependency_mode": "any_event",
    "file_browser": false,
    "active_execution_policy": "on_each_event"
  },
  "ui_assets": {
    "modal": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "css",
        "path": "assets/css/settings.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      }
    ],
    "inspector_panel": [
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "css",
        "path": "assets/css/settings.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      },
      {
        "kind": "js",
        "path": "assets/js/settings.js"
      },
      {
        "kind": "js",
        "path": "assets/js/inspector_panel.js"
      }
    ],
    "node_card": [
      {
        "kind": "css",
        "path": "assets/css/node_card.css"
      }
    ],
    "mini_node_card": [
      {
        "kind": "css",
        "path": "mini/node_card.css"
      }
    ]
  }
}
